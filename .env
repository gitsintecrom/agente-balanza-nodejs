# # .env en la carpeta agente-balanza
# FRONTEND_URL='http://localhost:5173'
# # Puerto en el que correrá este servicio de agente
# AGENTE_PORT=4000

# # Configuración del puerto serie de la balanza
# PUERTO_BALANZA=COM3
# BAUDRATE_BALANZA=9600
# DATA_BITS=8

# SIMULACION_BALANZA=true

# # --- NUEVAS VARIABLES PARA EL RANGO DE SIMULACIÓN ---
# SIMULACION_MIN=50
# SIMULACION_MAX=100








FRONTEND_URL='http://localhost:5173'
# Puerto en el que correrá este servicio de agente
AGENTE_PORT=4000

# Configuración común para ambas balanzas
BAUDRATE_BALANZA=9600
DATA_BITS=8
SIMULACION_BALANZA=false

# --- ✅ NUEVO: QUÉ BALANZA SIMULAR ---
# Valores posibles: 1 | 2 | AMBAS
SIMULAR_BALANZA=1

# --- BALANZA 1 (Ej. Hasta 5 Toneladas) ---
PUERTO_BALANZA_1=COM3
SIMULACION_MIN_1=50
SIMULACION_MAX_1=100

# --- BALANZA 2 (Ej. Hasta 15 Toneladas) ---
PUERTO_BALANZA_2=COM2
SIMULACION_MIN_2=5000
SIMULACION_MAX_2=15000